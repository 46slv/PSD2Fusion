{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSD2Fusion current program state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "status",
    "updated_date",
    "baseline",
    "reference_case",
    "active_task_id",
    "task_contract",
    "tasks",
    "transition_rule"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "program_id": {
      "const": "PSD2FUSION-COMPOSITING-PARITY"
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "blocked",
        "done"
      ]
    },
    "updated_date": {
      "type": "string",
      "format": "date"
    },
    "baseline": {
      "type": "object"
    },
    "reference_case": {
      "type": "object",
      "required": [
        "case_id",
        "psd_path_windows",
        "reference_png_path_windows",
        "read_only",
        "commit_inputs_or_full_renders",
        "identity_status",
        "normalization_status",
        "psd_sha256",
        "reference_png_sha256"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "psd_path_windows": {
          "type": "string"
        },
        "reference_png_path_windows": {
          "type": "string"
        },
        "read_only": {
          "const": true
        },
        "commit_inputs_or_full_renders": {
          "const": false
        },
        "identity_status": {
          "enum": [
            "unverified",
            "verified",
            "changed",
            "missing"
          ]
        },
        "normalization_status": {
          "enum": [
            "unverified",
            "verified",
            "ambiguous",
            "not_applicable"
          ]
        },
        "psd_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference_png_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "active_task_id": {
      "type": "string",
      "pattern": "^PARITY-[0-9]{3}$"
    },
    "task_contract": {
      "const": ".control/CURRENT_GOAL.md"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "requires",
          "verification",
          "branch",
          "commit",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PARITY-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "blocked",
              "ready",
              "in_progress",
              "awaiting_verification",
              "done",
              "blocked_host",
              "blocked_authority",
              "deferred"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^PARITY-[0-9]{3}$"
            }
          },
          "verification": {
            "enum": [
              "pending",
              "pass",
              "fail",
              "blocked"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "transition_rule": {
      "type": "string"
    }
  }
}
